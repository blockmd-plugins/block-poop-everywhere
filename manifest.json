{
  "app": "blockmd",
  "schema_version": 1,
  "id": "block-poop-everywhere",
  "category": "tools",
  "name": {
    "zh": "到处拉屎",
    "en": "Poop Everywhere"
  },
  "version": "1.0.11",
  "author": "Block Community",
  "repo": "blockmd-plugins/block-poop-everywhere",
  "summary": {
    "zh": "趣味整蛊彩蛋插件：在顶栏、背景和笔记里到处留痕，玩够一键冲水，兼作官方示例",
    "en": "Playful prank plugin to drop marks across Block and flush them clean, also an official UI showcase"
  },
  "entry": {
    "js": "main.js"
  },
  "permissions": [
    "storage",
    "notes:read",
    "notes:write",
    "events:note_saved",
    "system:fs",
    "ui:titlebar",
    "ui:commands",
    "ui:panels",
    "ui:status",
    "ui:notify",
    "ui:sidebar",
    "ui:appearance",
    "editor:read",
    "editor:write",
    "events:workspace"
  ],
  "permission_reasons": {
    "storage": {
      "zh": "记住你选的背景样式、附言内容和累计战绩，下次打开还在",
      "en": "Remember your backdrop style, custom captions, and drop stats across restarts"
    },
    "notes:read": {
      "zh": "数一数每篇笔记里留了多少痕，点侧栏记录就能直接跳过去",
      "en": "Count marks in each note so clicking the list jumps straight to that note"
    },
    "notes:write": {
      "zh": "往笔记里放进专属标记，点「冲水」时再把它们干净删掉",
      "en": "Place plugin marks inside notes and cleanly erase only those marks when flushing"
    },
    "events:note_saved": {
      "zh": "保存笔记后自动重新统计数量，让角标和状态栏数字保持最新",
      "en": "Recount marks right after you save a note to keep badges and counters fresh"
    },
    "system:fs": {
      "zh": "把扩展点参考手册导出到你指定的归档文件夹或下载目录",
      "en": "Export the extension reference guide into your chosen archive folder or Downloads"
    },
    "ui:titlebar": {
      "zh": "在顶栏放上开关面板、一键留痕和「冲水」按钮，并实时显示数量",
      "en": "Add board, quick-drop, and flush buttons with live counts to the top bar"
    },
    "ui:commands": {
      "zh": "把留痕和冲水动作放进命令面板、快捷键以及笔记和右键菜单里",
      "en": "Add drop and flush actions to the Command Palette, shortcuts, and right-click menus"
    },
    "ui:panels": {
      "zh": "在右侧打开「屎量面板」，查看实时统计、最近战报和快捷按钮",
      "en": "Open the Poop Board panel on the right for live stats, logs, and quick buttons"
    },
    "ui:status": {
      "zh": "在底部状态栏显示当前总数，点一下就能打开或收起右侧面板",
      "en": "Show the live drop count in the bottom status bar to toggle the right panel"
    },
    "ui:notify": {
      "zh": "操作后弹出轻提示，并在「全部冲掉」前弹窗让你再次确认",
      "en": "Show quick toast alerts after actions and confirm before flushing everything"
    },
    "ui:sidebar": {
      "zh": "在左侧栏加上「今日屎迹」列表、文件旁的小角标和右键清理菜单",
      "en": "Add Today's Drops list, file-tree badges, and right-click actions to the sidebar"
    },
    "ui:appearance": {
      "zh": "在编辑区铺上可调浓度的矢量图案背景，深色模式下还会发夜光",
      "en": "Show adjustable vector backdrops behind the editor, with dark-mode glow"
    },
    "editor:read": {
      "zh": "读取你在编辑器里选中的文字，好把它包进带附言的趣味标记块里",
      "en": "Read your selected text so you can wrap it into a fun marked callout"
    },
    "editor:write": {
      "zh": "把标记直接放进当前光标位置，或替换掉选中的那一段文字",
      "en": "Insert a mark at the cursor or wrap the currently selected text"
    },
    "events:workspace": {
      "zh": "切换笔记、深浅色主题或语言时，自动把面板和背景跟着换好",
      "en": "Update the board and backdrop automatically when you switch notes, theme, or language"
    }
  },
