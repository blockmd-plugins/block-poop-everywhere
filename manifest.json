{
  "app": "blockmd",
  "schema_version": 1,
  "id": "block-poop-everywhere",
  "category": "tools",
  "name": {
    "zh": "到处拉屎",
    "en": "Poop Everywhere"
  },
  "version": "1.0.4",
  "author": "Block Community",
  "repo": "blockmd-plugins/block-poop-everywhere",
  "summary": {
    "zh": "官方全扩展点示范插件：覆盖顶栏、侧栏、文件树角标、编辑区背景、面板、菜单、状态栏与弹窗",
    "en": "Official kitchen-sink demo covering titlebar, sidebar sections, file badges, editor backdrops, panels, menus, status bar, and dialogs"
  },
  "entry": {
    "command": [
      "python3",
      "-u",
      "main.py"
    ]
  },
  "permissions": [
    "storage",
    "notes:read",
    "notes:write",
    "events:note_saved",
    "ui:titlebar",
    "ui:settings",
    "ui:commands",
    "ui:panels",
    "ui:status",
    "ui:notify",
    "ui:sidebar",
    "ui:appearance",
    "editor:read",
    "editor:write",
    "events:workspace"
  ],
  "permission_reasons": {
    "storage": {
      "zh": "保存拉屎风格、背景参数、笔记本白名单与战况记录。",
      "en": "Save style preferences, backdrop settings, notebook allowlist, and drop history."
    },
    "notes:read": {
      "zh": "扫描笔记中的标记数量、展示统计并支持点击列表打开对应笔记。",
      "en": "Scan notes for drop markers, compute stats, and jump to notes from lists."
    },
    "notes:write": {
      "zh": "向笔记写入可识别标记并在冲水时精确清理插件留下的标记行。",
      "en": "Insert identifiable drop markers into notes and cleanly remove them on flush."
    },
    "events:note_saved": {
      "zh": "保存笔记后自动重算该页标记数并刷新文件树角标与状态栏。",
      "en": "Recount drop markers after note saves and refresh file badges and status bar."
    },
    "ui:titlebar": {
      "zh": "在顶栏挂载面板、快捷拉一坨与冲水按钮，并动态展示数量角标。",
      "en": "Mount panel, quick-drop, and flush buttons in the titlebar with live badges."
    },
    "ui:settings": {
      "zh": "在「外观」内置设置页末尾追加编辑区矢量背景与夜光快捷设置卡片。",
      "en": "Embed quick backdrop and dark-glow controls inside Appearance settings."
    },
    "ui:commands": {
      "zh": "向命令面板、默认快捷键、页面「…」菜单与编辑器右键菜单注册操作。",
      "en": "Register commands, default shortcuts, page menu items, and editor menu items."
    },
    "ui:panels": {
      "zh": "在右侧打开「屎量面板」展示实时统计、战报与快捷操作。",
      "en": "Open the right-hand Poop Board side panel for live metrics and actions."
    },
    "ui:status": {
      "zh": "在底部状态栏展示带图标的当前总数，点击可一键切换右侧面板。",
      "en": "Display a live icon counter in the bottom status bar to toggle the board."
    },
    "ui:notify": {
      "zh": "弹出四类语气带图标轻提示，并在冲水前打开二次确认弹窗。",
      "en": "Show icon-bearing toasts across all tones and open a flush confirmation dialog."
    },
    "ui:sidebar": {
      "zh": "在左侧栏挂载「今日屎迹」分区、文件树行尾角标与笔记右键菜单。",
      "en": "Add Today's Drops sidebar section, file-tree row badges, and tree context actions."
    },
    "ui:appearance": {
      "zh": "在编辑区背景层绘制可调图案、密度与暗色夜光效果的矢量水印。",
      "en": "Render configurable vector patterns, watermarks, and dark-glow editor backdrops."
    },
    "editor:read": {
      "zh": "读取当前编辑器选中文本，以便将其包装成带附言的标记块。",
      "en": "Read the active editor selection to wrap selected text into a marked block."
    },
    "editor:write": {
      "zh": "在当前光标处插入标记块，或直接替换选中的正文内容。",
      "en": "Insert marked blocks at the caret or replace the active editor selection."
    },
    "events:workspace": {
      "zh": "监听笔记切换、深浅色主题与语言变化事件并同步界面状态。",
      "en": "React to note open, theme change, and locale change workspace events."
    }
  },
  "surfaces": [
    "settings_page"
  ],
